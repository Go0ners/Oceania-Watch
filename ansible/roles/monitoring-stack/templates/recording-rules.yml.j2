groups:
  - name: node_recording_rules
    interval: 15s
    rules:
      # CPU
      - record: instance:node_cpu_utilization:ratio
        expr: 1 - avg by(instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))

      - record: instance:node_cpu_utilization:percent
        expr: 100 * instance:node_cpu_utilization:ratio

      # Memory
      - record: instance:node_memory_utilization:ratio
        expr: 1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)

      - record: instance:node_memory_utilization:percent
        expr: 100 * instance:node_memory_utilization:ratio

      - record: instance:node_memory_used:bytes
        expr: node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes

      # Disk
      - record: instance:node_filesystem_utilization:ratio
        expr: 1 - (node_filesystem_avail_bytes{mountpoint="/"} / node_filesystem_size_bytes{mountpoint="/"})

      - record: instance:node_filesystem_utilization:percent
        expr: 100 * instance:node_filesystem_utilization:ratio

      # Network
      - record: instance:node_network_receive:rate5m
        expr: rate(node_network_receive_bytes_total{device!~"lo|veth.*|docker.*|br-.*"}[5m])

      - record: instance:node_network_transmit:rate5m
        expr: rate(node_network_transmit_bytes_total{device!~"lo|veth.*|docker.*|br-.*"}[5m])

      # Disk I/O
      - record: instance:node_disk_read:rate5m
        expr: rate(node_disk_read_bytes_total[5m])

      - record: instance:node_disk_write:rate5m
        expr: rate(node_disk_written_bytes_total[5m])

  - name: container_recording_rules
    interval: 15s
    rules:
      # Container CPU
      - record: container:cpu_utilization:percent
        expr: rate(container_cpu_usage_seconds_total{name!=""}[5m]) * 100

      # Container Memory
      - record: container:memory_utilization:percent
        expr: (container_memory_usage_bytes{name!=""} / container_spec_memory_limit_bytes{name!=""}) * 100

      # Container Network
      - record: container:network_receive:rate5m
        expr: rate(container_network_receive_bytes_total{name!=""}[5m])

      - record: container:network_transmit:rate5m
        expr: rate(container_network_transmit_bytes_total{name!=""}[5m])

      # Container restarts
      - record: container:restarts:count24h
        expr: sum by(name) (changes(container_start_time_seconds{name!=""}[24h]))
