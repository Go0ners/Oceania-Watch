# CoreDNS Corefile
# Generated by Ansible - DO NOT EDIT MANUALLY

# Zone locale pour {{ coredns_domain }}
{{ coredns_domain }} {
    log
    errors

    # Résolution des sous-domaines vers Traefik
    hosts {
        {{ coredns_traefik_ip }} {{ coredns_domain }}
{% for service in coredns_local_services %}
        {{ service.ip }} {{ service.name }}.{{ coredns_domain }}
{% endfor %}
        fallthrough
    }

    # Forward vers DNS public si pas de match
    forward . {{ coredns_upstream_dns | join(' ') }}

    # Cache
    cache {{ coredns_cache_ttl }}
}

# Résolution locale .local (optionnel)
*.local {
    log
    errors

    # Résolution conteneurs Docker
    hosts {
{% for service in coredns_local_services %}
        {{ service.ip }} {{ service.name }}.local
{% endfor %}
        fallthrough
    }

    # Pas de forward pour .local (reste local)
    cache {{ coredns_cache_ttl }}
}

# Catch-all pour toutes les autres requêtes
. {
    log
    errors
    forward . {{ coredns_upstream_dns | join(' ') }}
    cache {{ coredns_cache_ttl }}
}
