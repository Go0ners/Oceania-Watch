# Traefik Static Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

global:
  checkNewVersion: false
  sendAnonymousUsage: false

{% if traefik_dashboard_enabled %}
api:
  dashboard: true
  insecure: false  # Dashboard sécurisé via labels Docker
{% endif %}

log:
  level: {{ traefik_log_level }}
  format: json

accessLog:
  format: json
  fields:
    defaultMode: keep
    names:
      ClientUsername: drop
    headers:
      defaultMode: keep
      names:
        User-Agent: keep
        Authorization: drop
        Cookie: drop

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
          permanent: true

  websecure:
    address: ":443"
    http:
      tls:
        certResolver: letsencrypt

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
    network: {{ traefik_network_name }}
    watch: true

  file:
    directory: "/etc/traefik/dynamic"
    watch: true

certificatesResolvers:
  letsencrypt:
    acme:
      email: {{ traefik_acme_email }}
      storage: {{ traefik_acme_storage }}
{% if traefik_use_staging_ca %}
      caServer: "https://acme-staging-v02.api.letsencrypt.org/directory"
{% endif %}
      dnsChallenge:
        provider: route53
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"
        delayBeforeCheck: 30s
