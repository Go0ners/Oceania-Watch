# Traefik Dynamic Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

http:
  middlewares:
    # Security Headers
    security-headers:
      headers:
        frameDeny: true
        sslRedirect: true
        browserXssFilter: true
        contentTypeNosniff: true
        stsIncludeSubdomains: true
        stsPreload: true
        stsSeconds: 31536000
        customFrameOptionsValue: "SAMEORIGIN"

    # HTTPS Redirect
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

  routers:
{% for service in traefik_services %}
    # Router HTTP {{ service.name }} (redirect to HTTPS)
    {{ service.name }}-http:
      rule: "Host(`{{ service.subdomain }}.{{ traefik_base_domain }}`)"
      entryPoints:
        - web
      middlewares:
        - https-redirect
      service: {{ service.name }}

    # Router HTTPS {{ service.name }}
    {{ service.name }}:
      rule: "Host(`{{ service.subdomain }}.{{ traefik_base_domain }}`)"
      entryPoints:
        - websecure
      tls:
        certResolver: letsencrypt
      middlewares:
        - security-headers
      service: {{ service.name }}

{% endfor %}

  services:
{% for service in traefik_services %}
    {{ service.name }}:
      loadBalancer:
        servers:
          - url: "http://{{ service.container_name }}:{{ service.port }}"
        healthCheck:
          path: /
          interval: 30s
          timeout: 5s

{% endfor %}
