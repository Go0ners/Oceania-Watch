#!/usr/bin/env bash

#################################################
# OceaniaWatch - Script de déploiement unifié
#################################################
# Gestion simplifiée du cycle de vie complet
# Commandes: deploy, destroy, status
#################################################

set -euo pipefail

# Couleurs pour les messages
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly NC='\033[0m' # No Color

# Répertoires du projet
readonly SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly TERRAFORM_BACKEND_DIR="${SCRIPT_DIR}/terraform/backend"
readonly TERRAFORM_INFRA_DIR="${SCRIPT_DIR}/terraform/infrastructure"
readonly ANSIBLE_DIR="${SCRIPT_DIR}/ansible"
readonly STATE_FILE="${SCRIPT_DIR}/.oceania-state"
readonly BACKUP_DIR="${SCRIPT_DIR}/.backups"
readonly CREDENTIALS_FILE="${SCRIPT_DIR}/.oceania-credentials"

# Variables globales
QUIET_MODE=false
VERBOSE_MODE=false

#################################################
# Fonctions utilitaires
#################################################

print_header() {
    printf "${CYAN}\n"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "  %s\n" "$1"
    printf "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n"
    printf "${NC}\n"
}

log_info() {
    printf "${BLUE}ℹ${NC}  %s\n" "$1"
}

log_success() {
    printf "${GREEN}✓${NC}  %s\n" "$1"
}

log_warning() {
    printf "${YELLOW}⚠${NC}  %s\n" "$1"
}

log_error() {
    printf "${RED}✗${NC}  %s\n" "$1" >&2
}

spinner() {
    local pid=$1
    local message=$2
    local spinstr='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'

    if [[ "$QUIET_MODE" == true ]]; then
        wait "$pid"
        return $?
    fi

    while kill -0 "$pid" 2>/dev/null; do
        local temp=${spinstr#?}
        printf " [%c] %s" "$spinstr" "$message"
        local spinstr=$temp${spinstr%"$temp"}
        sleep 0.1
        printf "\r"
    done

    wait "$pid"
    local exit_code=$?
    printf "\r%-$(tput cols)s\r" ""
    return $exit_code
}

run_with_spinner() {
    local message=$1
    shift
    local cmd=("$@")
    local output_file=$(mktemp)
    
    "${cmd[@]}" > "$output_file" 2>&1 &
    local pid=$!
    spinner $pid "$message"
    local exit_code=$?
    
    if [[ $exit_code -ne 0 ]]; then
        echo ""
        log_error "Commande échouée: ${cmd[*]}"
        cat "$output_file"
    fi
    rm -f "$output_file"
    return $exit_code
}

run_terraform() {
    local action=$1
    shift
    
    if [[ "$VERBOSE_MODE" == true ]]; then
        terraform "$action" "$@"
    else
        local output_file=$(mktemp)
        terraform "$action" "$@" > "$output_file" 2>&1
        local exit_code=$?
        
        if [[ $exit_code -ne 0 ]]; then
            cat "$output_file"
        else
            # Afficher un résumé
            local added=$(grep -oE 'added|created' "$output_file" | wc -l | tr -d ' ')
            local changed=$(grep -oE 'changed|modified' "$output_file" | wc -l | tr -d ' ')
            local destroyed=$(grep -oE 'destroyed' "$output_file" | wc -l | tr -d ' ')
            if [[ "$action" == "apply" ]]; then
                log_success "Terraform apply: ${added} ajouté(s), ${changed} modifié(s)"
            elif [[ "$action" == "destroy" ]]; then
                log_success "Terraform destroy: ${destroyed} détruit(s)"
            fi
        fi
        rm -f "$output_file"
        return $exit_code
    fi
}

confirm() {
    local message=$1
    local default=${2:-n}

    if [[ "$default" == "y" ]]; then
        local prompt="[Y/n]"
    else
        local prompt="[y/N]"
    fi

    printf "${YELLOW}?${NC}  %s %s " "$message" "$prompt"
    read -r response

    response=${response:-$default}
    response=$(echo "$response" | tr '[:upper:]' '[:lower:]')
    [[ "$response" =~ ^(y|yes)$ ]]
}

confirm_destructive() {
    local message=$1

    printf "${RED}⚠${NC}  %s\n" "$message"
    printf "${RED}⚠${NC}  Êtes-vous sûr ? [y/${YELLOW}N${NC}]: "
    read -r response

    response=$(echo "$response" | tr '[:upper:]' '[:lower:]')
    [[ "$response" =~ ^(y|yes)$ ]]
}

check_prerequisites() {
    log_info "Vérification des prérequis..."

    local missing=()

    command -v terraform >/dev/null 2>&1 || missing+=("terraform")
    command -v ansible >/dev/null 2>&1 || missing+=("ansible")
    command -v aws >/dev/null 2>&1 || missing+=("aws-cli")

    if [[ ${#missing[@]} -gt 0 ]]; then
        log_error "Outils manquants: ${missing[*]}"
        log_info "Installation requise:"
        for tool in "${missing[@]}"; do
            case $tool in
                terraform) echo "  - Terraform: https://developer.hashicorp.com/terraform/downloads" ;;
                ansible) echo "  - Ansible: pip install ansible" ;;
                aws-cli) echo "  - AWS CLI: https://aws.amazon.com/cli/" ;;
            esac
        done
        return 1
    fi

    log_success "Tous les prérequis sont installés"
    return 0
}

check_aws_credentials() {
    log_info "Vérification des credentials AWS..."

    if ! aws sts get-caller-identity >/dev/null 2>&1; then
        log_error "Credentials AWS invalides ou manquants"
        log_info "Configurez AWS CLI avec: aws configure"
        return 1
    fi

    log_success "Credentials AWS validés"
    return 0
}

save_state() {
    local step=$1
    local status=$2

    mkdir -p "$(dirname "$STATE_FILE")"
    echo "${step}:${status}:$(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$STATE_FILE"
}

get_last_state() {
    if [[ -f "$STATE_FILE" ]]; then
        tail -n 1 "$STATE_FILE" | cut -d: -f1
    else
        echo "none"
    fi
}

create_backup() {
    local backup_name=$1

    mkdir -p "$BACKUP_DIR"
    local backup_path="${BACKUP_DIR}/backup-${backup_name}-$(date +%Y%m%d-%H%M%S)"

    log_info "Création d'une sauvegarde: ${backup_name}"

    # Backup Terraform state files
    if [[ -f "${TERRAFORM_BACKEND_DIR}/terraform.tfstate" ]]; then
        mkdir -p "${backup_path}/backend"
        cp "${TERRAFORM_BACKEND_DIR}/terraform.tfstate" "${backup_path}/backend/"
    fi

    if [[ -f "${TERRAFORM_INFRA_DIR}/terraform.tfstate" ]]; then
        mkdir -p "${backup_path}/infrastructure"
        cp "${TERRAFORM_INFRA_DIR}/terraform.tfstate" "${backup_path}/infrastructure/"
    fi

    # Backup SSH keys
    if [[ -d "$HOME/.ssh/oceania" ]]; then
        mkdir -p "${backup_path}/ssh"
        cp -r "$HOME/.ssh/oceania" "${backup_path}/ssh/"
    fi

    # Backup state file
    if [[ -f "$STATE_FILE" ]]; then
        cp "$STATE_FILE" "${backup_path}/"
    fi

    # Backup credentials
    if [[ -f "$CREDENTIALS_FILE" ]]; then
        cp "$CREDENTIALS_FILE" "${backup_path}/"
    fi

    log_success "Sauvegarde créée: ${backup_path}"
    echo "$backup_path"
}

generate_password() {
    openssl rand -base64 32 | tr -d "=+/" | cut -c1-24
}

save_credentials() {
    local ip=$1
    local grafana_pass=$2

    cat > "$CREDENTIALS_FILE" <<EOF
{
  "generated_at": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "instance_ip": "$ip",
  "grafana": {
    "url": "http://$ip:3000",
    "user": "admin",
    "password": "$grafana_pass"
  },
  "prometheus": {
    "url": "http://$ip:9090"
  },
  "alertmanager": {
    "url": "http://$ip:9093"
  },
  "node_exporter": {
    "url": "http://$ip:9100/metrics"
  },
  "cadvisor": {
    "url": "http://$ip:8080"
  },
  "loki": {
    "url": "http://$ip:3100"
  }
}
EOF
    chmod 600 "$CREDENTIALS_FILE"
}

#################################################
# Fonctions de déploiement
#################################################

deploy_backend() {
    print_header "Étape 1/3 - Déploiement du Backend Terraform"

    cd "$TERRAFORM_BACKEND_DIR"

    if [[ ! -f "terraform.tfvars" ]]; then
        if [[ -f "terraform.tfvars.example" ]]; then
            log_warning "terraform.tfvars non trouvé, copie de l'exemple"
            cp terraform.tfvars.example terraform.tfvars
            log_info "Éditez ${TERRAFORM_BACKEND_DIR}/terraform.tfvars puis relancez"
            return 1
        else
            log_error "Fichier terraform.tfvars manquant dans ${TERRAFORM_BACKEND_DIR}"
            return 1
        fi
    fi

    log_info "Initialisation Terraform backend..."
    if ! run_with_spinner "Initialisation en cours..." terraform init -input=false; then
        log_error "Échec de l'initialisation Terraform"
        return 1
    fi

    log_info "Validation de la configuration..."
    terraform validate >/dev/null 2>&1

    log_info "Application de l'infrastructure backend..."
    run_terraform apply -auto-approve

    if [[ $? -eq 0 ]]; then
        save_state "backend" "deployed"
        log_success "Backend déployé avec succès"

        # Mettre à jour automatiquement le backend dans infrastructure/main.tf
        local bucket_name=$(terraform output -raw s3_bucket_name 2>/dev/null)
        if [[ -n "$bucket_name" ]]; then
            log_info "Mise à jour du backend dans infrastructure/main.tf..."
            cd "$TERRAFORM_INFRA_DIR"

            # Mettre à jour le nom du bucket dans le fichier main.tf
            sed -i.bak "s/bucket[[:space:]]*=[[:space:]]*\"oceania-watch-.*-tfstate-[a-z0-9]*\"/bucket       = \"${bucket_name}\"/" main.tf

            # Supprimer le backup si la mise à jour a réussi
            rm -f main.tf.bak

            log_success "Backend mis à jour: ${bucket_name}"
            cd "$TERRAFORM_BACKEND_DIR"
        fi

        return 0
    else
        log_error "Échec du déploiement du backend"
        return 1
    fi
}

deploy_infrastructure() {
    print_header "Étape 2/3 - Déploiement de l'Infrastructure EC2"

    cd "$TERRAFORM_INFRA_DIR"

    if [[ ! -f "terraform.tfvars" ]]; then
        if [[ -f "terraform.tfvars.example" ]]; then
            log_warning "terraform.tfvars non trouvé, copie de l'exemple"
            cp terraform.tfvars.example terraform.tfvars
            log_info "Éditez ${TERRAFORM_INFRA_DIR}/terraform.tfvars puis relancez"
            return 1
        else
            log_error "Fichier terraform.tfvars manquant dans ${TERRAFORM_INFRA_DIR}"
            return 1
        fi
    fi

    # Récupérer le nom du bucket depuis le backend
    cd "$TERRAFORM_BACKEND_DIR"
    BUCKET_NAME=$(terraform output -raw s3_bucket_name 2>/dev/null)
    cd "$TERRAFORM_INFRA_DIR"

    if [[ -n "$BUCKET_NAME" ]]; then
        # Récupérer la région depuis le backend
        local BACKEND_REGION=$(cd "$TERRAFORM_BACKEND_DIR" && terraform output -raw aws_region 2>/dev/null || echo "us-east-1")
        log_info "Configuration backend avec bucket: $BUCKET_NAME"
        cat > backend.hcl <<EOF
bucket       = "$BUCKET_NAME"
key          = "infrastructure/terraform.tfstate"
region       = "$BACKEND_REGION"
use_lockfile = true
encrypt      = true
EOF
        log_success "backend.hcl généré automatiquement"
    else
        log_error "Impossible de récupérer le nom du bucket"
        log_info "Assurez-vous que le backend est déployé"
        return 1
    fi

    log_info "Initialisation Terraform infrastructure..."
    if [[ ! -d ".terraform" ]]; then
        if ! run_with_spinner "Initialisation en cours..." terraform init -input=false -backend-config=backend.hcl -reconfigure; then
            log_error "Échec de l'initialisation Terraform"
            return 1
        fi
    else
        if ! run_with_spinner "Initialisation en cours..." terraform init -input=false -backend-config=backend.hcl; then
            log_error "Échec de l'initialisation Terraform"
            return 1
        fi
    fi

    log_info "Validation de la configuration..."
    terraform validate >/dev/null 2>&1

    log_info "Application de l'infrastructure EC2..."
    run_terraform apply -auto-approve

    if [[ $? -eq 0 ]]; then
        save_state "infrastructure" "deployed"
        log_success "Infrastructure déployée avec succès"

        # Attendre que l'instance soit prête via AWS CLI
        local instance_id=$(terraform output -raw instance_id 2>/dev/null)
        if [[ -n "$instance_id" ]]; then
            log_info "Attente du démarrage de l'instance ${instance_id}..."

            # Attendre que l'instance soit 'running'
            if run_with_spinner "Instance en cours de démarrage..." aws ec2 wait instance-running --instance-ids "$instance_id" --no-cli-pager; then
                log_success "Instance en cours d'exécution"

                # Attendre que les status checks passent
                log_info "Attente des vérifications système..."
                if run_with_spinner "Vérifications système en cours..." aws ec2 wait instance-status-ok --instance-ids "$instance_id" --no-cli-pager; then
                    log_success "Instance prête et accessible"
                else
                    log_warning "Vérifications système en attente (peut prendre quelques minutes)"
                fi
            else
                log_warning "Impossible de vérifier l'état de l'instance"
            fi
        fi

        return 0
    else
        log_error "Échec du déploiement de l'infrastructure"
        return 1
    fi
}

configure_instance() {
    print_header "Étape 3/4 - Configuration Ansible de l'instance"

    cd "$ANSIBLE_DIR"

    log_info "Installation des collections Ansible..."
    if [[ -f "requirements.yml" ]]; then
        run_with_spinner "Installation des collections..." ansible-galaxy collection install -r requirements.yml
    fi

    log_info "Mise à jour de l'inventaire depuis Terraform..."
    if [[ -f "update-inventory.sh" ]]; then
        bash update-inventory.sh >/dev/null 2>&1
    fi

    log_info "Test de connectivité SSH..."
    local max_retries=5
    local retry=0

    while [[ $retry -lt $max_retries ]]; do
        if ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
            log_success "Connectivité SSH établie"
            break
        else
            retry=$((retry + 1))
            if [[ $retry -lt $max_retries ]]; then
                log_warning "Tentative ${retry}/${max_retries} - Nouvelle tentative dans 10s..."
                sleep 10
            else
                log_error "Impossible d'établir la connexion SSH"
                return 1
            fi
        fi
    done

    log_info "Exécution des playbooks de configuration..."
    ansible-playbook playbooks/setup-instance.yml

    if [[ $? -eq 0 ]]; then
        save_state "configuration" "deployed"
        log_success "Configuration appliquée avec succès"

        log_info "Validation de l'installation..."
        ansible-playbook playbooks/validate-setup.yml

        return 0
    else
        log_error "Échec de la configuration Ansible"
        return 1
    fi
}

deploy_monitoring() {
    print_header "Étape 4/4 - Déploiement de la Stack Monitoring"

    cd "$ANSIBLE_DIR"

    # Générer mot de passe Grafana
    local grafana_password=$(generate_password)
    log_info "Génération du mot de passe Grafana..."

    log_info "Déploiement de Prometheus, Grafana, Alertmanager..."
    ansible-playbook playbooks/deploy-monitoring.yml \
        -e "grafana_admin_password=$grafana_password"

    if [[ $? -eq 0 ]]; then
        save_state "monitoring" "deployed"
        log_success "Stack monitoring déployée avec succès"

        log_info "Validation de la stack monitoring..."
        ansible-playbook playbooks/validate-monitoring.yml

        # Sauvegarder credentials
        cd "$TERRAFORM_INFRA_DIR"
        local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
        if [[ "$instance_ip" != "N/A" ]]; then
            save_credentials "$instance_ip" "$grafana_password"
            log_success "Credentials sauvegardés dans .oceania-credentials"
        fi

        return 0
    else
        log_error "Échec du déploiement de la stack monitoring"
        return 1
    fi
}

#################################################
# Fonction de déploiement commune
#################################################

do_deploy() {
    local include_monitoring=${1:-false}
    local backup_name="pre-deploy"
    local header_title="🚀 DÉPLOIEMENT INFRASTRUCTURE"
    
    if [[ "$include_monitoring" == true ]]; then
        backup_name="pre-deploy-all"
        header_title="🚀 DÉPLOIEMENT COMPLET OCEANIA-WATCH"
    fi

    print_header "$header_title"

    # Vérifications préalables
    check_prerequisites || exit 1
    check_aws_credentials || exit 1

    # Créer une sauvegarde avant déploiement
    local backup_path=$(create_backup "$backup_name")

    # Déterminer à quelle étape reprendre
    local last_state=$(get_last_state)
    log_info "État actuel: ${last_state}"

    # Déploiement séquentiel
    local failed=false

    # Étape 1: Backend
    if [[ "$last_state" == "none" || "$last_state" == "destroyed" || "$last_state" == "" ]]; then
        deploy_backend || failed=true
    fi

    # Étape 2: Infrastructure
    if [[ "$failed" == false ]]; then
        if [[ "$last_state" == "none" || "$last_state" == "destroyed" || "$last_state" == "backend" || "$last_state" == "" ]]; then
            deploy_infrastructure || failed=true
        fi
    fi

    # Étape 3: Configuration
    if [[ "$failed" == false ]]; then
        if [[ "$last_state" != "monitoring" ]]; then
            configure_instance || failed=true
        fi
    fi

    # Étape 4: Monitoring (si demandé)
    if [[ "$failed" == false && "$include_monitoring" == true ]]; then
        deploy_monitoring || failed=true
    fi

    # Résumé final
    echo ""
    if [[ "$failed" == false ]]; then
        # Récupérer l'IP de connexion
        cd "$TERRAFORM_INFRA_DIR"
        local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
        local ssh_key=$(terraform output -raw private_key_path 2>/dev/null || echo "N/A")

        if [[ "$include_monitoring" == true ]]; then
            print_header "✓ DÉPLOIEMENT COMPLET TERMINÉ AVEC SUCCÈS"
            printf "${GREEN}Infrastructure complète déployée et configurée !${NC}\n"
        else
            print_header "✓ INFRASTRUCTURE DÉPLOYÉE AVEC SUCCÈS"
            printf "${GREEN}Infrastructure déployée et configurée !${NC}\n"
        fi

        echo ""
        echo "Connexion SSH:"
        printf "  ${CYAN}ssh -i %s ec2-user@%s${NC}\n" "$ssh_key" "$instance_ip"
        echo ""

        if [[ "$include_monitoring" == true ]]; then
            echo "Services de monitoring:"
            printf "  ${CYAN}Prometheus:    http://%s:9090${NC}\n" "$instance_ip"
            printf "  ${CYAN}Grafana:       http://%s:3000${NC}\n" "$instance_ip"
            printf "  ${CYAN}Alertmanager:  http://%s:9093${NC}\n" "$instance_ip"
            echo ""
            echo "Pour gérer l'instance:"
            echo "  ./oceania credentials - Afficher les logins/passwords"
            echo "  ./oceania status      - Voir l'état"
            echo "  ./oceania destroy     - Détruire l'infrastructure"
        else
            echo "Prochaines étapes:"
            echo "  ./oceania deploy-monitoring  - Déployer la stack monitoring"
            echo "  ./oceania status             - Voir l'état"
        fi
        echo ""
    else
        print_header "✗ ÉCHEC DU DÉPLOIEMENT"
        log_error "Le déploiement a échoué"
        log_info "Sauvegarde disponible: ${backup_path}"
        log_info "Consultez les logs ci-dessus pour plus de détails"
        exit 1
    fi
}

#################################################
# Commande DEPLOY-INFRA (Backend + Infrastructure)
#################################################

cmd_deploy_infra() {
    do_deploy false
}

#################################################
# Commande DEPLOY-MONITORING (Stack Monitoring)
#################################################

cmd_deploy_monitoring() {
    print_header "📊 DÉPLOIEMENT STACK MONITORING"

    # Vérifier que l'infrastructure est déployée
    local last_state=$(get_last_state)
    if [[ "$last_state" == "none" || "$last_state" == "destroyed" || "$last_state" == "backend" ]]; then
        log_error "Infrastructure non déployée"
        log_info "Déployez d'abord l'infrastructure avec: ./oceania deploy-infra"
        exit 1
    fi

    # Vérifier la connectivité
    cd "$ANSIBLE_DIR"
    if ! ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
        log_error "Instance non accessible"
        log_info "Vérifiez que l'infrastructure est déployée et accessible"
        exit 1
    fi

    # Déployer la stack monitoring
    if deploy_monitoring; then
        echo ""
        print_header "✓ STACK MONITORING DÉPLOYÉE AVEC SUCCÈS"

        # Récupérer l'IP
        cd "$TERRAFORM_INFRA_DIR"
        local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")

        printf "${GREEN}Stack monitoring opérationnelle !${NC}\n"
        echo ""
        echo "Services de monitoring:"
        printf "  ${CYAN}Prometheus:    http://%s:9090${NC}\n" "$instance_ip"
        printf "  ${CYAN}Grafana:       http://%s:3000${NC}\n" "$instance_ip"
        printf "  ${CYAN}Alertmanager:  http://%s:9093${NC}\n" "$instance_ip"
        printf "  ${CYAN}Node Exporter: http://%s:9100/metrics${NC}\n" "$instance_ip"
        printf "  ${CYAN}cAdvisor:      http://%s:8080${NC}\n" "$instance_ip"
        echo ""
        log_info "Pour afficher les credentials: ./oceania credentials"
        echo ""
    else
        print_header "✗ ÉCHEC DU DÉPLOIEMENT MONITORING"
        log_error "Le déploiement de la stack monitoring a échoué"
        exit 1
    fi
}

#################################################
# Commande DEPLOY-ALL (Tout déployer)
#################################################

cmd_deploy_all() {
    do_deploy true
}

#################################################
# Commande DESTROY (infrastructure seulement)
#################################################

cmd_destroy() {
    print_header "💥 DESTRUCTION INFRASTRUCTURE"

    printf "${YELLOW}ATTENTION: Cette action va détruire l'infrastructure EC2${NC}\n"
    echo ""
    echo "Cela inclut:"
    echo "  - Instance EC2 et ressources associées"
    echo "  - Clés SSH (sauvegardées avant suppression)"
    echo ""
    printf "${YELLOW}Le backend Terraform (S3, DynamoDB) sera conservé${NC}\n"
    echo ""

    if ! confirm "Voulez-vous détruire l'infrastructure EC2 ?" "n"; then
        log_info "Destruction annulée"
        exit 0
    fi

    # Créer une sauvegarde
    local backup_path=$(create_backup "pre-destroy-infra")
    log_success "Sauvegarde créée: ${backup_path}"

    log_info "Destruction de l'infrastructure EC2..."
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        run_terraform destroy -auto-approve
        log_success "Infrastructure EC2 détruite"
    else
        log_warning "Aucune infrastructure EC2 trouvée"
    fi

    # Nettoyage des fichiers Terraform infrastructure
    log_info "Nettoyage des fichiers locaux..."
    rm -rf "${TERRAFORM_INFRA_DIR}/.terraform"
    rm -f "${TERRAFORM_INFRA_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_INFRA_DIR}/terraform.tfstate"*

    save_state "backend" "active"

    echo ""
    print_header "✓ DESTRUCTION TERMINÉE"
    echo ""
    log_success "Infrastructure EC2 détruite"
    log_info "Backend Terraform conservé (S3 + DynamoDB)"
    log_info "Sauvegarde: ${backup_path}"
    echo ""
    echo "Pour redéployer l'infrastructure:"
    printf "  ${CYAN}./oceania deploy${NC}\n"
    echo ""
    echo "Pour détruire également le backend:"
    printf "  ${CYAN}./oceania destroy-all${NC}\n"
    echo ""
}

#################################################
# Commande DESTROY-ALL (tout détruire)
#################################################

cmd_destroy_all() {
    print_header "💥 DESTRUCTION COMPLÈTE OCEANIAWATCH"

    printf "${RED}ATTENTION: Cette action va détruire TOUTE l'infrastructure${NC}\n"
    echo ""
    echo "Cela inclut:"
    echo "  - Instance EC2 et ressources associées"
    echo "  - Backend Terraform (S3, DynamoDB)"
    echo "  - Clés SSH (sauvegardées avant suppression)"
    echo ""
    printf "${RED}CETTE ACTION EST IRRÉVERSIBLE !${NC}\n"
    echo ""

    if ! confirm_destructive "Cette action va détruire TOUTE l'infrastructure (irréversible)"; then
        log_info "Destruction annulée"
        exit 0
    fi

    # Créer une sauvegarde complète
    local backup_path=$(create_backup "pre-destroy-all")
    log_success "Sauvegarde complète créée: ${backup_path}"

    # 1. Infrastructure EC2
    log_info "Destruction de l'infrastructure EC2..."
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        run_terraform destroy -auto-approve
        log_success "Infrastructure EC2 détruite"
    else
        log_warning "Aucune infrastructure EC2 trouvée"
    fi

    # 2. Backend Terraform
    log_info "Destruction du backend Terraform..."
    cd "$TERRAFORM_BACKEND_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        # Vider le bucket S3
        local bucket_name=$(terraform output -raw s3_bucket_name 2>/dev/null || echo "")
        if [[ -n "$bucket_name" ]]; then
            log_info "Vidage du bucket S3: ${bucket_name}"
            aws s3 rm "s3://${bucket_name}" --recursive --no-cli-pager 2>/dev/null || true

            # Supprimer toutes les versions
            aws s3api list-object-versions \
                --bucket "$bucket_name" \
                --query 'Versions[].{Key:Key,VersionId:VersionId}' \
                --output text \
                --no-cli-pager 2>/dev/null | \
            while read -r key version; do
                [[ -n "$key" ]] && aws s3api delete-object --bucket "$bucket_name" --key "$key" --version-id "$version" --no-cli-pager 2>/dev/null || true
            done

            # Supprimer les delete markers
            aws s3api list-object-versions \
                --bucket "$bucket_name" \
                --query 'DeleteMarkers[].{Key:Key,VersionId:VersionId}' \
                --output text \
                --no-cli-pager 2>/dev/null | \
            while read -r key version; do
                [[ -n "$key" ]] && aws s3api delete-object --bucket "$bucket_name" --key "$key" --version-id "$version" --no-cli-pager 2>/dev/null || true
            done
        fi

        run_terraform destroy -auto-approve
        log_success "Backend Terraform détruit"
    else
        log_warning "Aucun backend Terraform trouvé"
    fi

    # 3. Nettoyage des fichiers locaux
    log_info "Nettoyage des fichiers locaux..."
    rm -f "$STATE_FILE"
    
    # Vider le fichier credentials
    if [[ -f "$CREDENTIALS_FILE" ]]; then
        > "$CREDENTIALS_FILE"
    fi

    # Nettoyer les fichiers Terraform
    rm -rf "${TERRAFORM_BACKEND_DIR}/.terraform"
    rm -f "${TERRAFORM_BACKEND_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_BACKEND_DIR}/terraform.tfstate"*

    rm -rf "${TERRAFORM_INFRA_DIR}/.terraform"
    rm -f "${TERRAFORM_INFRA_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_INFRA_DIR}/terraform.tfstate"*

    save_state "destroyed" "complete"

    echo ""
    print_header "✓ DESTRUCTION COMPLÈTE TERMINÉE"
    echo ""
    log_success "Toute l'infrastructure a été détruite"
    log_info "Sauvegarde complète: ${backup_path}"
    echo ""
    echo "Les clés SSH et les fichiers de configuration ont été sauvegardés dans:"
    printf "  ${CYAN}%s${NC}\n" "$backup_path"
    echo ""
}

