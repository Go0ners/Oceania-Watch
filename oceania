#################################################
# Main
#################################################

main() {
    # Pas d'arguments = aide
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    # Parse des options globales
    while [[ $# -gt 0 ]]; do
        case $1 in
            -q|--quiet)
                QUIET_MODE=true
                shift
                ;;
            -v|--verbose)
                VERBOSE_MODE=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            quickstart|deploy-all|deploy-infra|deploy-monitoring|destroy|destroy-all|status|credentials|clean|help)
                local command=$1
                shift
                break
                ;;
            *)
                log_error "Commande inconnue: $1"
                echo ""
                show_help
                exit 1
                ;;
        esac
    done

    # Exécution de la commande
    case ${command:-help} in
        quickstart)
            cmd_quickstart "$@"
            ;;
        deploy-all)
            cmd_deploy_all "$@"
            ;;
        deploy-infra)
            cmd_deploy_infra "$@"
            ;;
        deploy-monitoring)
            cmd_deploy_monitoring "$@"
            ;;
        destroy)
            cmd_destroy "$@"
            ;;
        destroy-all)
            cmd_destroy_all "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        credentials)
            cmd_credentials "$@"
            ;;
        clean)
            cmd_clean "$@"
            ;;
        help)
            show_help
            ;;
        *)
            log_error "Commande inconnue: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Point d'entrée
main "$@"
