#################################################
# Commande DESTROY (infrastructure seulement)
#################################################

cmd_destroy() {
    print_header "💥 DESTRUCTION INFRASTRUCTURE"

    printf "${YELLOW}ATTENTION: Cette action va détruire l'infrastructure EC2${NC}\n"
    echo ""
    echo "Cela inclut:"
    echo "  - Instance EC2 et ressources associées"
    echo "  - Clés SSH (sauvegardées avant suppression)"
    echo ""
    printf "${YELLOW}Le backend Terraform (S3, DynamoDB) sera conservé${NC}\n"
    echo ""

    if ! confirm "Voulez-vous détruire l'infrastructure EC2 ?" "n"; then
        log_info "Destruction annulée"
        exit 0
    fi

    # Créer une sauvegarde
    local backup_path=$(create_backup "pre-destroy-infra")
    log_success "Sauvegarde créée: ${backup_path}"

    # Destruction de l'infrastructure EC2
    log_info "Destruction de l'infrastructure EC2..."
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        terraform destroy -auto-approve
        log_success "Infrastructure EC2 détruite"
    else
        log_warning "Aucune infrastructure EC2 trouvée"
    fi

    # Nettoyage des fichiers Terraform infrastructure
    log_info "Nettoyage des fichiers locaux..."
    rm -rf "${TERRAFORM_INFRA_DIR}/.terraform"
    rm -f "${TERRAFORM_INFRA_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_INFRA_DIR}/terraform.tfstate"*

    save_state "backend" "active"

    echo ""
    print_header "✓ DESTRUCTION TERMINÉE"
    echo ""
    log_success "Infrastructure EC2 détruite"
    log_info "Backend Terraform conservé (S3 + DynamoDB)"
    log_info "Sauvegarde: ${backup_path}"
    echo ""
    echo "Pour redéployer l'infrastructure:"
    printf "  ${CYAN}./oceania deploy${NC}\n"
    echo ""
    echo "Pour détruire également le backend:"
    printf "  ${CYAN}./oceania destroy-all${NC}\n"
    echo ""
}

#################################################
# Commande DESTROY-ALL (tout détruire)
#################################################

cmd_destroy_all() {
    print_header "💥 DESTRUCTION COMPLÈTE OCEANIAWATCH"

    printf "${RED}ATTENTION: Cette action va détruire TOUTE l'infrastructure${NC}\n"
    echo ""
    echo "Cela inclut:"
    echo "  - Instance EC2 et ressources associées"
    echo "  - Backend Terraform (S3, DynamoDB)"
    echo "  - Clés SSH (sauvegardées avant suppression)"
    echo ""
    printf "${RED}CETTE ACTION EST IRRÉVERSIBLE !${NC}\n"
    echo ""

    if ! confirm_destructive "Cette action est irréversible" "DESTROY-ALL"; then
        log_info "Destruction annulée"
        exit 0
    fi

    # Créer une sauvegarde complète
    local backup_path=$(create_backup "pre-destroy-all")
    log_success "Sauvegarde complète créée: ${backup_path}"

    # 1. Infrastructure EC2
    log_info "Destruction de l'infrastructure EC2..."
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        terraform destroy -auto-approve
        log_success "Infrastructure EC2 détruite"
    else
        log_warning "Aucune infrastructure EC2 trouvée"
    fi

    # 2. Backend Terraform
    log_info "Destruction du backend Terraform..."
    cd "$TERRAFORM_BACKEND_DIR"
    if [[ -f "terraform.tfstate" ]] || terraform show >/dev/null 2>&1; then
        # Vider le bucket S3
        local bucket_name=$(terraform output -raw s3_bucket_name 2>/dev/null || echo "")
        if [[ -n "$bucket_name" ]]; then
            log_info "Vidage du bucket S3: ${bucket_name}"
            aws s3 rm "s3://${bucket_name}" --recursive --no-cli-pager 2>/dev/null || true

            # Supprimer toutes les versions
            aws s3api list-object-versions \
                --bucket "$bucket_name" \
                --query 'Versions[].{Key:Key,VersionId:VersionId}' \
                --output text \
                --no-cli-pager 2>/dev/null | \
            while read -r key version; do
                [[ -n "$key" ]] && aws s3api delete-object --bucket "$bucket_name" --key "$key" --version-id "$version" --no-cli-pager 2>/dev/null || true
            done

            # Supprimer les delete markers
            aws s3api list-object-versions \
                --bucket "$bucket_name" \
                --query 'DeleteMarkers[].{Key:Key,VersionId:VersionId}' \
                --output text \
                --no-cli-pager 2>/dev/null | \
            while read -r key version; do
                [[ -n "$key" ]] && aws s3api delete-object --bucket "$bucket_name" --key "$key" --version-id "$version" --no-cli-pager 2>/dev/null || true
            done
        fi

        terraform destroy -auto-approve
        log_success "Backend Terraform détruit"
    else
        log_warning "Aucun backend Terraform trouvé"
    fi

    # 3. Nettoyage des fichiers locaux
    log_info "Nettoyage des fichiers locaux..."
    rm -f "$STATE_FILE"

    # Nettoyer les fichiers Terraform
    rm -rf "${TERRAFORM_BACKEND_DIR}/.terraform"
    rm -f "${TERRAFORM_BACKEND_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_BACKEND_DIR}/terraform.tfstate"*

    rm -rf "${TERRAFORM_INFRA_DIR}/.terraform"
    rm -f "${TERRAFORM_INFRA_DIR}/.terraform.lock.hcl"
    rm -f "${TERRAFORM_INFRA_DIR}/terraform.tfstate"*

    save_state "destroyed" "complete"

    echo ""
    print_header "✓ DESTRUCTION COMPLÈTE TERMINÉE"
    echo ""
    log_success "Toute l'infrastructure a été détruite"
    log_info "Sauvegarde complète: ${backup_path}"
    echo ""
    echo "Les clés SSH et les fichiers de configuration ont été sauvegardés dans:"
    printf "  ${CYAN}%s${NC}\n" "$backup_path"
    echo ""
}

#################################################
# Commande STATUS
#################################################

cmd_status() {
    print_header "📊 ÉTAT OCEANIAWATCH"

    local last_state=$(get_last_state)

    echo "État actuel: ${last_state}"
    echo ""

    # Backend status
    printf "${CYAN}Backend Terraform:${NC}\n"
    cd "$TERRAFORM_BACKEND_DIR"
    if [[ -d ".terraform" ]]; then
        if terraform show >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Déployé\n"
            local bucket=$(terraform output -raw s3_bucket_name 2>/dev/null || echo "N/A")
            echo "  Bucket S3: ${bucket}"
        else
            printf "  ${YELLOW}⚠${NC} Initialisé mais non déployé\n"
        fi
    else
        printf "  ${RED}✗${NC} Non initialisé\n"
    fi
    echo ""

    # Infrastructure status
    printf "${CYAN}Infrastructure EC2:${NC}\n"
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -d ".terraform" ]]; then
        if terraform show >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Déployée\n"
            local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
            local instance_id=$(terraform output -raw instance_id 2>/dev/null || echo "N/A")
            echo "  IP: ${instance_ip}"
            echo "  ID: ${instance_id}"

            # Vérifier l'état de l'instance
            if [[ "$instance_id" != "N/A" ]]; then
                local instance_state=$(aws ec2 describe-instances \
                    --instance-ids "$instance_id" \
                    --query 'Reservations[0].Instances[0].State.Name' \
                    --output text 2>/dev/null || echo "unknown")
                echo "  État: ${instance_state}"
            fi
        else
            printf "  ${YELLOW}⚠${NC} Initialisée mais non déployée\n"
        fi
    else
        printf "  ${RED}✗${NC} Non initialisée\n"
    fi
    echo ""

    # Configuration status
    printf "${CYAN}Configuration Ansible:${NC}\n"
    cd "$ANSIBLE_DIR"
    if ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
        printf "  ${GREEN}✓${NC} Instance accessible\n"

        # Vérifier Docker
        if ansible all -m ansible.builtin.shell -a "docker --version" >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Docker installé\n"
        else
            printf "  ${RED}✗${NC} Docker non installé\n"
        fi
    else
        printf "  ${YELLOW}⚠${NC} Instance non accessible\n"
    fi
    echo ""

    # Monitoring status
    printf "${CYAN}Stack Monitoring:${NC}\n"
    if ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
        # Vérifier si les conteneurs de monitoring existent
        local monitoring_containers=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=prometheus --filter name=grafana --filter name=alertmanager --format '{{.Names}}'" 2>/dev/null | grep -v "CHANGED" | wc -l)
        
        if [[ $monitoring_containers -gt 0 ]]; then
            printf "  ${GREEN}✓${NC} Déployée\n"
            
            # Afficher les services actifs
            local prometheus_status=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=prometheus --format '{{.Status}}'" 2>/dev/null | grep -v "CHANGED" | head -1)
            local grafana_status=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=grafana --format '{{.Status}}'" 2>/dev/null | grep -v "CHANGED" | head -1)
            
            if [[ -n "$prometheus_status" ]]; then
                printf "  ${GREEN}✓${NC} Prometheus: running\n"
            fi
            if [[ -n "$grafana_status" ]]; then
                printf "  ${GREEN}✓${NC} Grafana: running\n"
            fi
            
            # Afficher les URLs
            cd "$TERRAFORM_INFRA_DIR"
            local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
            if [[ "$instance_ip" != "N/A" ]]; then
                echo "  URLs:"
                echo "    Prometheus: http://${instance_ip}:9090"
                echo "    Grafana: http://${instance_ip}:3000"
            fi
        else
            printf "  ${YELLOW}⚠${NC} Non déployée\n"
            echo "  Pour déployer: cd ansible && ansible-playbook playbooks/deploy-monitoring.yml"
        fi
    else
        printf "  ${RED}✗${NC} Instance non accessible\n"
    fi
    echo ""

    # Sauvegardes
    if [[ -d "$BACKUP_DIR" ]]; then
        local backup_count=$(find "$BACKUP_DIR" -type d -name "backup-*" | wc -l)
        printf "${CYAN}Sauvegardes:${NC}\n"
        echo "  ${backup_count} sauvegarde(s) disponible(s)"
        if [[ $backup_count -gt 0 ]]; then
            echo "  Dernière: $(ls -t "$BACKUP_DIR" | head -1)"
        fi
    fi
}

#################################################
# Aide et usage
#################################################

