cmd_credentials() {
    local action=${1:-show}

    if [[ "$action" == "--regenerate" ]]; then
        print_header "🔄 RÉGÉNÉRATION MOT DE PASSE GRAFANA"

        if [[ ! -f "$CREDENTIALS_FILE" ]]; then
            log_error "Aucun credential trouvé"
            log_info "Déployez d'abord avec: ./oceania deploy-all"
            exit 1
        fi

        # Générer nouveau mot de passe
        local new_pass=$(generate_password)
        log_info "Génération d'un nouveau mot de passe..."

        # Mettre à jour via Ansible
        cd "$ANSIBLE_DIR"
        if ansible oceania -m shell -a "docker exec grafana grafana-cli admin reset-admin-password $new_pass" >/dev/null 2>&1; then
            log_success "Mot de passe Grafana mis à jour"

            # Mettre à jour le fichier credentials
            local ip=$(grep -o '"instance_ip": "[^"]*' "$CREDENTIALS_FILE" | cut -d'"' -f4)
            save_credentials "$ip" "$new_pass"
            log_success "Credentials sauvegardés"

            echo ""
            action="show"
        else
            log_error "Échec de la mise à jour du mot de passe"
            exit 1
        fi
    fi

    if [[ "$action" == "show" ]]; then
        if [[ ! -f "$CREDENTIALS_FILE" ]]; then
