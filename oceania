    echo ""
    printf "${YELLOW}USAGE:${NC}\n"
    echo "    ./oceania <commande> [options]"
    echo ""
    printf "${YELLOW}COMMANDES DE DÉPLOIEMENT:${NC}\n"
    printf "    ${GREEN}deploy-all${NC}        Déployer TOUT de A à Z\n"
    echo "                        - Backend Terraform (S3 + DynamoDB)"
    echo "                        - Infrastructure EC2 (instance, réseau, SSH)"
    echo "                        - Configuration Ansible (Docker, outils)"
    echo "                        - Stack Monitoring (Prometheus, Grafana, etc.)"
    echo ""
    printf "    ${GREEN}deploy-infra${NC}      Déployer uniquement l'infrastructure\n"
    echo "                        - Backend Terraform (S3 + DynamoDB)"
    echo "                        - Infrastructure EC2 (instance, réseau, SSH)"
    echo "                        - Configuration Ansible (Docker, outils)"
    echo ""
    printf "    ${GREEN}deploy-monitoring${NC} Déployer uniquement la stack monitoring\n"
    echo "                        - Prometheus, Grafana, Alertmanager"
    echo "                        - Node Exporter, cAdvisor, Loki"
    echo "                        - Prérequis: infrastructure déployée"
    echo ""
    echo ""
    printf "${YELLOW}COMMANDES DE GESTION:${NC}\n"
    printf "    ${RED}destroy${NC}     Détruire l'infrastructure EC2 uniquement\n"
    echo "                  - Suppression instance EC2 et ressources associées"
    echo "                  - Conservation du backend Terraform (S3, DynamoDB)"
    echo "                  - Possibilité de redéployer rapidement"
    echo ""
    printf "    ${RED}destroy-all${NC} Détruire TOUTE l'infrastructure\n"
    echo "                  - Suppression EC2 + Backend Terraform"
    echo "                  - Sauvegarde automatique avant destruction"
    echo "                  - Action irréversible (confirmation requise)"
    echo ""
    printf "    ${BLUE}status${NC}      Afficher l'état actuel du déploiement\n"
    echo "                  - État du backend Terraform"
    echo "                  - État de l'infrastructure EC2"
    echo "                  - État de la configuration Ansible"
    echo "                  - État de la stack monitoring"
    echo ""
    printf "    ${CYAN}help${NC}        Afficher cette aide\n"
    echo ""
    printf "${YELLOW}OPTIONS:${NC}\n"
    echo "    -q, --quiet     Mode silencieux (pas d'interactions)"
    echo "    -h, --help      Afficher l'aide"
}

#################################################
# Main
#################################################

main() {
    # Pas d'arguments = aide
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    # Parse des options globales
    while [[ $# -gt 0 ]]; do
        case $1 in
            -q|--quiet)
                QUIET_MODE=true
                shift
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            deploy-all|deploy-infra|deploy-monitoring|destroy|destroy-all|status|help)
                local command=$1
                shift
                break
                ;;
            *)
                log_error "Commande inconnue: $1"
                echo ""
                show_help
                exit 1
                ;;
        esac
    done

    # Exécution de la commande
    case ${command:-help} in
        deploy-all)
            cmd_deploy_all "$@"
            ;;
        deploy-infra)
            cmd_deploy_infra "$@"
            ;;
        deploy-monitoring)
            cmd_deploy_monitoring "$@"
            ;;
        destroy)
            cmd_destroy "$@"
            ;;
        destroy-all)
            cmd_destroy_all "$@"
            ;;
        status)
            cmd_status "$@"
            ;;
        help)
            show_help
            ;;
        *)
            log_error "Commande inconnue: $command"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

# Point d'entrée
main "$@"
