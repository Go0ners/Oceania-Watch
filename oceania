# Commande STATUS
#################################################

cmd_status() {
    print_header "📊 ÉTAT OCEANIAWATCH"

    local last_state=$(get_last_state)

    echo "État actuel: ${last_state}"
    echo ""

    # Backend status
    printf "${CYAN}Backend Terraform:${NC}\n"
    cd "$TERRAFORM_BACKEND_DIR"
    if [[ -d ".terraform" ]]; then
        if terraform show >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Déployé\n"
            local bucket=$(terraform output -raw s3_bucket_name 2>/dev/null || echo "N/A")
            echo "  Bucket S3: ${bucket}"
        else
            printf "  ${YELLOW}⚠${NC} Initialisé mais non déployé\n"
        fi
    else
        printf "  ${RED}✗${NC} Non initialisé\n"
    fi
    echo ""

    # Infrastructure status
    printf "${CYAN}Infrastructure EC2:${NC}\n"
    cd "$TERRAFORM_INFRA_DIR"
    if [[ -d ".terraform" ]]; then
        if terraform show >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Déployée\n"
            local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
            local instance_id=$(terraform output -raw instance_id 2>/dev/null || echo "N/A")
            echo "  IP: ${instance_ip}"
            echo "  ID: ${instance_id}"

            # Vérifier l'état de l'instance
            if [[ "$instance_id" != "N/A" ]]; then
                local instance_state=$(aws ec2 describe-instances \
                    --instance-ids "$instance_id" \
                    --query 'Reservations[0].Instances[0].State.Name' \
                    --output text 2>/dev/null || echo "unknown")
                echo "  État: ${instance_state}"
            fi
        else
            printf "  ${YELLOW}⚠${NC} Initialisée mais non déployée\n"
        fi
    else
        printf "  ${RED}✗${NC} Non initialisée\n"
    fi
    echo ""

    # Configuration status
    printf "${CYAN}Configuration Ansible:${NC}\n"
    cd "$ANSIBLE_DIR"
    if ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
        printf "  ${GREEN}✓${NC} Instance accessible\n"

        # Vérifier Docker
        if ansible all -m ansible.builtin.shell -a "docker --version" >/dev/null 2>&1; then
            printf "  ${GREEN}✓${NC} Docker installé\n"
        else
            printf "  ${RED}✗${NC} Docker non installé\n"
        fi
    else
        printf "  ${YELLOW}⚠${NC} Instance non accessible\n"
    fi
    echo ""

    # Monitoring status
    printf "${CYAN}Stack Monitoring:${NC}\n"
    if ansible all -m ansible.builtin.ping >/dev/null 2>&1; then
        # Vérifier si les conteneurs de monitoring existent
        local monitoring_containers=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=prometheus --filter name=grafana --filter name=alertmanager --format '{{.Names}}'" 2>/dev/null | grep -v "CHANGED" | wc -l)
        
        if [[ $monitoring_containers -gt 0 ]]; then
            printf "  ${GREEN}✓${NC} Déployée\n"
            
            # Afficher les services actifs
            local prometheus_status=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=prometheus --format '{{.Status}}'" 2>/dev/null | grep -v "CHANGED" | head -1)
            local grafana_status=$(ansible all -m ansible.builtin.shell -a "docker ps --filter name=grafana --format '{{.Status}}'" 2>/dev/null | grep -v "CHANGED" | head -1)
            
            if [[ -n "$prometheus_status" ]]; then
                printf "  ${GREEN}✓${NC} Prometheus: running\n"
            fi
            if [[ -n "$grafana_status" ]]; then
                printf "  ${GREEN}✓${NC} Grafana: running\n"
            fi
            
            # Afficher les URLs
            cd "$TERRAFORM_INFRA_DIR"
            local instance_ip=$(terraform output -raw instance_public_ip 2>/dev/null || echo "N/A")
            if [[ "$instance_ip" != "N/A" ]]; then
                echo "  URLs:"
                echo "    Prometheus: http://${instance_ip}:9090"
                echo "    Grafana: http://${instance_ip}:3000"
            fi
        else
            printf "  ${YELLOW}⚠${NC} Non déployée\n"
            echo "  Pour déployer: cd ansible && ansible-playbook playbooks/deploy-monitoring.yml"
        fi
    else
        printf "  ${RED}✗${NC} Instance non accessible\n"
    fi
    echo ""

    # Sauvegardes
    if [[ -d "$BACKUP_DIR" ]]; then
        local backup_count=$(find "$BACKUP_DIR" -type d -name "backup-*" | wc -l)
        printf "${CYAN}Sauvegardes:${NC}\n"
        echo "  ${backup_count} sauvegarde(s) disponible(s)"
        if [[ $backup_count -gt 0 ]]; then
            echo "  Dernière: $(ls -t "$BACKUP_DIR" | head -1)"
        fi
    fi
}

#################################################
# Commande QUICKSTART
#################################################

prompt_with_default() {
    local prompt=$1
    local default=$2
    local result

    printf "${CYAN}?${NC}  %s [${YELLOW}%s${NC}]: " "$prompt" "$default" >&2
    read -r result
    echo "${result:-$default}"
}

prompt_choice() {
    local prompt=$1
    shift
    local options=("$@")
    local choice

    printf "${CYAN}?${NC}  %s\n" "$prompt" >&2
    for i in "${!options[@]}"; do
        printf "   ${YELLOW}%d)${NC} %s\n" "$((i+1))" "${options[$i]}" >&2
    done
    printf "   Choix [${YELLOW}%s${NC}]: " "${options[0]}" >&2
    read -r choice
    choice=${choice:-1}

    if [[ $choice -ge 1 && $choice -le ${#options[@]} ]]; then
        echo "${options[$((choice-1))]}"
    else
        echo "${options[0]}"
    fi
}

validate_ip() {
    local ip=$1
    if [[ $ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]]; then
        local IFS='.'
        read -ra octets <<< "$ip"
        for octet in "${octets[@]}"; do
            if [[ $octet -gt 255 ]]; then
                return 1
            fi
        done
        return 0
    fi
    return 1
}

validate_project_name() {
    local name=$1
    if [[ $name =~ ^[a-zA-Z][a-zA-Z0-9-]*$ && ${#name} -ge 3 && ${#name} -le 32 ]]; then
        return 0
    fi
    return 1
}

validate_aws_region() {
    local region=$1
    local valid_regions="us-east-1 us-east-2 us-west-1 us-west-2 eu-west-1 eu-west-2 eu-west-3 eu-central-1 eu-north-1 ap-southeast-1 ap-southeast-2 ap-northeast-1 ap-northeast-2 ap-south-1 sa-east-1 ca-central-1"
    if [[ " $valid_regions " =~ " $region " ]]; then
        return 0
    fi
    return 1
}

prompt_validated() {
    local prompt=$1
    local default=$2
    local validator=$3
    local error_msg=$4
    local result

    while true; do
        result=$(prompt_with_default "$prompt" "$default")
        if $validator "$result"; then
            echo "$result"
            return 0
        else
            log_error "$error_msg" >&2
        fi
    done
}

cmd_quickstart() {
    print_header "⚡ QUICKSTART - Configuration interactive"

    # 1. Vérification des prérequis
    log_info "Vérification des prérequis..."
    if ! check_prerequisites; then
        log_error "Installez les outils manquants avant de continuer"
        exit 1
    fi

    if ! check_aws_credentials; then
        log_error "Configurez AWS CLI avant de continuer"
        exit 1
    fi
    log_success "Prérequis OK"
    echo ""

    # 2. Détection IP publique
    log_info "Détection de votre IP publique..."
    local detected_ip=""
    detected_ip=$(curl -s --max-time 5 https://checkip.amazonaws.com 2>/dev/null || \
                  curl -s --max-time 5 https://ifconfig.me 2>/dev/null || \
                  curl -s --max-time 5 https://ipinfo.io/ip 2>/dev/null || \
                  echo "")

    if [[ -n "$detected_ip" ]]; then
        log_success "IP détectée: ${detected_ip}"
    else
        log_warning "Impossible de détecter votre IP"
    fi
    echo ""

    # 3. Questions interactives
    print_header "📝 Configuration du projet"

    local project_name
    project_name=$(prompt_validated "Nom du projet" "oceania-watch" validate_project_name "Le nom doit contenir 3-32 caractères (lettres, chiffres, tirets)")

    local environment
    environment=$(prompt_choice "Environnement" "Dev" "Staging" "Qual" "Prod")

    local aws_region
    aws_region=$(prompt_validated "Région AWS" "us-east-1" validate_aws_region "Région invalide. Ex: us-east-1, eu-west-1, ap-southeast-1")

    local allowed_ip
    if [[ -n "$detected_ip" ]]; then
        allowed_ip=$(prompt_validated "IP autorisée pour SSH" "${detected_ip}" validate_ip "Format IP invalide (ex: 192.168.1.1)")
    else
        allowed_ip=$(prompt_validated "IP autorisée pour SSH (votre IP publique)" "" validate_ip "Format IP invalide (ex: 192.168.1.1)")
    fi

    echo ""
    print_header "📝 Configuration EC2 (optionnel)"

    local instance_type
    instance_type=$(prompt_with_default "Type d'instance EC2" "t3.large")

    local volume_size
    volume_size=$(prompt_with_default "Taille du disque (GB)" "100")

    # 4. Résumé et confirmation
    echo ""
    print_header "📋 Résumé de la configuration"

    printf "  Projet:      ${GREEN}%s${NC}\n" "$project_name"
    printf "  Env:         ${GREEN}%s${NC}\n" "$environment"
    printf "  Région AWS:  ${GREEN}%s${NC}\n" "$aws_region"
    printf "  IP SSH:      ${GREEN}%s/32${NC}\n" "$allowed_ip"
    printf "  Instance:    ${GREEN}%s${NC}\n" "$instance_type"
    printf "  Disque:      ${GREEN}%s GB${NC}\n" "$volume_size"
    echo ""

    if ! confirm "Confirmer cette configuration ?" "y"; then
        log_info "Configuration annulée"
        exit 0
    fi

    # 5. Génération des fichiers
    echo ""
    log_info "Génération des fichiers de configuration..."

    # Backend terraform.tfvars
    cat > "${TERRAFORM_BACKEND_DIR}/terraform.tfvars" <<EOF
# Configuration générée par ./oceania quickstart

project_name      = "${project_name}"
environment       = "${environment}"
aws_region        = "${aws_region}"
enable_versioning = true
EOF
    log_success "terraform/backend/terraform.tfvars créé"

    # Infrastructure terraform.tfvars
    cat > "${TERRAFORM_INFRA_DIR}/terraform.tfvars" <<EOF
# Configuration générée par ./oceania quickstart

project_name      = "${project_name}"
environment       = "${environment}"
aws_region        = "${aws_region}"
allowed_ssh_ips   = ["${allowed_ip}/32"]

instance_type     = "${instance_type}"
root_volume_size  = ${volume_size}
root_volume_type  = "gp3"

enable_public_ip              = true
enable_detailed_monitoring    = false
enable_termination_protection = false

ssh_key_directory = "~/.ssh/oceania"
EOF
    log_success "terraform/infrastructure/terraform.tfvars créé"

    # Résumé final
    echo ""
    print_header "✓ CONFIGURATION TERMINÉE"

    printf "${GREEN}Environnement prêt pour le déploiement !${NC}\n"
    echo ""
    echo "Prochaine étape:"
    printf "  ${GREEN}./oceania deploy-all${NC}\n"
    echo ""
}

