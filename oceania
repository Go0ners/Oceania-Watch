    local files_to_clean=(
        "${TERRAFORM_BACKEND_DIR}/terraform.tfvars"
        "${TERRAFORM_BACKEND_DIR}/.terraform"
        "${TERRAFORM_BACKEND_DIR}/.terraform.lock.hcl"
