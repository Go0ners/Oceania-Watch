        "$STATE_FILE"
        "$CREDENTIALS_FILE"
        "$BACKUP_DIR"
    )

    local found_files=()
    for file in "${files_to_clean[@]}"; do
        if [[ -e "$file" ]]; then
            found_files+=("$file")
